{
  "name": "servion",
  "version": "0.0.1",
  "private": true,
  "description": "An easy-to-use Docker container management interface.",
  "license": "MIT",
  "author": {
    "name": "Inticate Softworks",
    "email": "contact@inticate.com"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "web:start": "bun --env-file=.env run --filter '@servion/web' start",
    "web:dev": "bun --env-file=.env run --filter '@servion/web' dev",
    "orval:generate": "bun --env-file=.env run --filter '@servion/web' orval",
    "orval:watch": "bun --env-file=.env run --filter '@servion/web' orval --watch",
    "prepare": "husky",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "stats": "bunx cloc . --exclude-dir=node_modules,out,types,include,.husky,.vscode,.idea,.forgejo,.github,.codex,.agents,.git --match-f=\"[.]tsx?$\""
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "cloc": "^2.6.0-cloc",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "bun run lint",
    "src/**/*.{ts,tsx}": "bun run format"
  }
}
